{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/ride.py": {
      "excludeFiles": "{analysis_page.py,app.py,pages/**,route_map.py,route_map_frontend/**,.streamlit/**,README.md}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
